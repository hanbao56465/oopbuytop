---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import {
  categoryName,
  displayPrice,
  formatProductUpdatedAt,
  maisonProductUrl,
  productPageUrl,
  englishSize,
  qcCatalogProducts,
} from '../../lib/catalog';
import { priorityFindFor } from '../../lib/find-content';
import { catalogCategories } from '../../lib/catalog';
import { searchCategorySlugs } from '../../lib/category-content';

// Only some categories have their own /category/ page. Link to the nearest
// ancestor that has one (e.g. casual-dresses -> dresses) so we never link to a 404.
function categoryPageFor(slug: string | null) {
  let current = slug;
  const seen = new Set<string>();
  while (current && !seen.has(current)) {
    if (searchCategorySlugs.includes(current)) return current;
    seen.add(current);
    current = catalogCategories.find((category) => category.slug === current)?.parentSlug ?? null;
  }
  return null;
}

export function getStaticPaths() {
  return qcCatalogProducts.map((product) => ({ params: { slug: product.slug }, props: { product } }));
}

const { product } = Astro.props;
const priorityContent = priorityFindFor(product.slug);
const priorityKeyword = priorityContent ? `${priorityContent.keyword.charAt(0).toUpperCase()}${priorityContent.keyword.slice(1)}` : undefined;
const productCategory = categoryName(product.category);
const categoryPage = categoryPageFor(product.category);
const categoryPageName = categoryPage ? categoryName(categoryPage) : productCategory;
const checkedAt = formatProductUpdatedAt(product);
const relatedCandidates = qcCatalogProducts.filter((candidate) => candidate.slug !== product.slug);
const related = [
  ...relatedCandidates.filter((candidate) => candidate.category === product.category),
  ...relatedCandidates.filter((candidate) => candidate.category !== product.category && candidate.brand && candidate.brand === product.brand),
  ...relatedCandidates,
].filter((candidate, index, items) => items.findIndex((item) => item.slug === candidate.slug) === index).slice(0, 5);
const metaDescription = priorityContent
  ? `${product.title} Oopbuy spreadsheet find with ${product.qcPhotoCount} QC-photo references, ${displayPrice(product)} price context and focused comparison checks.`
  : `${product.title} Oopbuy spreadsheet research page with ${product.qcPhotoCount} warehouse QC-photo references, ${displayPrice(product)} price context and current-listing checks.`;
const pageUrl = `https://oopbuytop.net/finds/${product.slug}/`;
const schemaGraph: Record<string, unknown>[] = [
    {
      '@type': 'WebPage',
      name: priorityKeyword ?? `${product.title} Oopbuy Find`,
      url: pageUrl,
      description: metaDescription,
      dateModified: product.updatedAt,
      primaryImageOfPage: product.images?.[0] ? { '@type': 'ImageObject', url: product.images[0] } : undefined,
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://oopbuytop.net/' },
        { '@type': 'ListItem', position: 2, name: 'Oopbuy finds', item: 'https://oopbuytop.net/finds/' },
        { '@type': 'ListItem', position: 3, name: product.title, item: pageUrl },
      ],
    },
];
if (priorityContent) {
  schemaGraph.push({
    '@type': 'FAQPage',
    mainEntity: priorityContent.faqs.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: { '@type': 'Answer', text: item.answer },
    })),
  });
}
const pageSchema = JSON.stringify({ '@context': 'https://schema.org', '@graph': schemaGraph });

// Order block + QC strip data (all from the local snapshot).
const backHref = categoryPage ? `/category/${categoryPage}/` : '/finds/';
const backLabel = categoryPage ? `Back to ${categoryPageName}` : 'Back to catalog';
const orderUrl = maisonProductUrl(product, 'find_detail_primary');
const copyUrl = productPageUrl(product);
const sizes = (product.variant?.availableSizes ?? []).filter(Boolean);
// skuLabel is raw seller text (often Chinese); only surface the size token if present.
const sizeHint = (label: string | null) => {
  const raw = label?.match(/(?:尺码|size)\s*[:：]\s*([^;|]+)/i)?.[1];
  const clean = raw ? englishSize(raw) : '';
  return /[A-Za-z0-9]/.test(clean) ? clean : undefined;
};
const qcGroups = (product.qcGroups ?? [])
  .filter((group) => group.images?.length)
  .sort((a, b) => Number(b.isPreferred) - Number(a.isPreferred))
  .map((group) => {
    const size = sizeHint(group.skuLabel);
    return {
      label: group.isPreferred ? 'Matched style photos' : 'Other reference photos',
      detail: size ? `Size ${size}` : null,
      cover: group.images[0].thumbnailUrl || group.images[0].url,
      images: group.images.map((image) => image.url),
    };
  });
const qcPhotoTotal = qcGroups.reduce((sum, group) => sum + group.images.length, 0);
const galleryData = JSON.stringify({ main: product.images?.[0] ?? null, title: product.title, groups: qcGroups.map(({ label, images }) => ({ label, images })) });
---
<BaseLayout
  noindex={true}
  title={priorityKeyword ? `${priorityKeyword} | OopbuyTop` : `${product.title} Oopbuy Find: Price & QC Photos | OopbuyTop`}
  description={metaDescription}
  image={product.images?.[0]}
>
  <a class="pd-back" href={backHref}>← {backLabel}</a>
  <article class="pd" data-pd={galleryData}>
    <div class="pd-media">
      {product.images?.[0]
        ? <button class="pd-zoom" type="button" data-open-main aria-label={`Enlarge photo of ${product.title}`}>
            <img src={product.images[0]} alt={product.title} width="760" height="760" loading="eager" />
          </button>
        : <div class="pd-placeholder" aria-hidden="true">No photo yet</div>}
      <p class="pd-hint"><span class="pd-hint-hover">Hover to zoom · click to enlarge</span><span class="pd-hint-touch">Tap to enlarge</span></p>
    </div>

    <div class="pd-info">
      <div class="pd-tags">
        {product.brand && <span class="pd-tag">{product.brand}</span>}
        {categoryPage
          ? <a class="pd-tag pd-tag-lane" href={`/category/${categoryPage}/`}>{productCategory}</a>
          : <span class="pd-tag pd-tag-lane">{productCategory}</span>}
      </div>
      <h1>{product.title}</h1>
      <button class="pd-copy" type="button" data-copy={copyUrl}><span data-copy-label>Copy buy link</span></button>

      <div class="pd-price">
        <strong>{displayPrice(product)}</strong>
        <span>Reference price · snapshot {checkedAt}</span>
        <small>Excludes shipping, service and payment fees.</small>
      </div>

      <div class="pd-qc-entry">
        <a class="pd-qc-button" href="#qc-photos">View QC photos{qcPhotoTotal ? ` (${qcPhotoTotal})` : ''}</a>
        <span>Historical reference photos</span>
      </div>

      {sizes.length > 0 && <div class="pd-sizes">
        <p class="pd-label">Size</p>
        <div class="pd-size-list">{sizes.map((size) => <span>{size}</span>)}</div>
        <p class="pd-note">Preview only — choose your size again on the order page to confirm stock.</p>
      </div>}

      <a class="pd-cta" href={orderUrl} target="_blank" rel="sponsored noopener noreferrer">View / Order this item <span aria-hidden="true">↗</span></a>
      <p class="pd-note">Opens in a new tab. Confirm style, size and the final price on the order page. OopbuyTop does not sell items or take payment.</p>

      <nav class="pd-help" aria-label="Buying help">
        <a href="/oopbuy-spreadsheet/">How to buy →</a>
        <a href="/guides/oopbuy-shipping-guide/">Shipping &amp; fees →</a>
      </nav>
    </div>
  </article>

  <section class="pd-qc" id="qc-photos">
    <div class="pd-qc-head">
      <div>
        <h2>QC photos</h2>
        <p class="pd-qc-stats">{qcGroups.length} QC group{qcGroups.length === 1 ? '' : 's'} · {qcPhotoTotal} photo{qcPhotoTotal === 1 ? '' : 's'}</p>
        <p class="pd-note">Compare the style, colour and size in each group with the option you order. Only groups marked “matched” were checked against this style.</p>
      </div>
      {qcGroups.length > 1 && <div class="pd-qc-arrows">
        <button type="button" data-qc-prev aria-label="Scroll QC groups left">←</button>
        <button type="button" data-qc-next aria-label="Scroll QC groups right">→</button>
      </div>}
    </div>
    {qcGroups.length
      ? <>
          <div class="pd-qc-track" data-qc-track>
            {qcGroups.map((group, index) => <button class="pd-qc-card" type="button" data-qc-group={index} aria-label={`Open ${group.label}, ${group.images.length} photos`}>
              <span class="pd-qc-cover"><img src={group.cover} alt="" loading="lazy" width="240" height="240" /><b>{group.images.length} photo{group.images.length === 1 ? '' : 's'}</b></span>
              <span class="pd-qc-caption"><strong class:list={{ 'is-matched': group.label.startsWith('Matched') }}>{group.label}</strong>{group.detail && <small>{group.detail}</small>}</span>
            </button>)}
          </div>
          <div class="pd-qc-bar" data-qc-bar aria-hidden="true"></div>
          {product.qcTruncated && <p class="pd-note">More QC groups exist than are shown here.</p>}
        </>
      : <div class="pd-qc-empty"><span aria-hidden="true">📷</span><p>No QC photos in this snapshot yet. Ask for warehouse photos after you order.</p></div>}
  </section>

  <dialog class="pd-lightbox" data-lightbox aria-label="Photo viewer">
    <button class="pd-lb-close" type="button" data-lb-close aria-label="Close">×</button>
    <button class="pd-lb-nav pd-lb-prev" type="button" data-lb-prev aria-label="Previous photo">‹</button>
    <figure><img data-lb-img alt="" /><figcaption data-lb-caption></figcaption></figure>
    <button class="pd-lb-nav pd-lb-next" type="button" data-lb-next aria-label="Next photo">›</button>
  </dialog>

  <section class="find-detail-content">
    <div>
      <p class="eyebrow">Listing summary</p>
      <h2>What the current snapshot says</h2>
      <p>{product.description}</p>
      {categoryPage
        ? <p>This entry was grouped under {productCategory}{categoryPage !== product.category && <> in <a href={`/category/${categoryPage}/`}>{categoryPageName}</a></>}{categoryPage === product.category && <> — see the <a href={`/category/${categoryPage}/`}>{categoryPageName} category</a></>}. Use the category page to compare it with similar finds instead of relying on one cover image or price.</p>
        : <p>This entry was grouped under {productCategory}. Compare it with similar finds instead of relying on one cover image or price.</p>}
    </div>
    <aside>
      <p class="eyebrow">Before ordering</p>
      <h2>Verify these details</h2>
      <ol>
        <li>Match the exact title, image and selected option on the live listing.</li>
        <li>Confirm the current price, size or configuration and availability.</li>
        <li>Compare every available warehouse QC angle with the order record.</li>
        <li>Use current checkout information for shipping and destination restrictions.</li>
      </ol>
      <a class="text-link" href="/guides/oopbuy-qc-photos/">Open the QC photo checklist →</a>
    </aside>
  </section>

  {priorityContent && <section class="priority-find-content" data-priority-find>
    <div>
      <p class="eyebrow">Focused comparison</p>
      <h2>{priorityContent.heading}</h2>
      <p>{priorityContent.intro}</p>
      <ul>{priorityContent.comparisonPoints.map((point) => <li>{point}</li>)}</ul>
    </div>
    <aside>
      <p class="eyebrow">Search phrase covered</p>
      <strong>{priorityKeyword}</strong>
      <p>This page is one of 15 focused entries chosen for clearer product intent and current QC-reference evidence. It remains a research page, not a product endorsement.</p>
      {categoryPage && <a class="text-link" href={`/category/${categoryPage}/`}>Compare the full {categoryPageName} category →</a>}
    </aside>
  </section>}

  {priorityContent && <section class="priority-find-faq">
    <p class="eyebrow">Product-specific questions</p>
    <h2>{product.title} research FAQ</h2>
    {priorityContent.faqs.map((item) => <details><summary>{item.question}</summary><p>{item.answer}</p></details>)}
  </section>}

  <section class="find-related">
    <div class="section-heading"><div><p class="eyebrow">Compare before choosing</p><h2>Related Oopbuy spreadsheet finds</h2></div><a class="section-link" href="/finds/">Search all QC-reference finds →</a></div>
    <div class="product-grid">{related.map((item) => <ProductCard product={item} placement="find_detail_related" />)}</div>
  </section>
  <script type="application/ld+json" set:html={pageSchema} />
</BaseLayout>

<script>
  const root = document.querySelector<HTMLElement>('[data-pd]');
  if (root) {
    const data = JSON.parse(root.dataset.pd || '{}') as { main: string | null; title: string; groups: { label: string; images: string[] }[] };

    // Hover zoom on the main photo: scale toward the cursor.
    const zoom = root.querySelector<HTMLElement>('.pd-zoom');
    const zoomImg = zoom?.querySelector('img');
    if (zoom && zoomImg && matchMedia('(hover: hover)').matches) {
      zoom.addEventListener('mousemove', (event) => {
        const box = zoom.getBoundingClientRect();
        zoomImg.style.transformOrigin = `${((event.clientX - box.left) / box.width) * 100}% ${((event.clientY - box.top) / box.height) * 100}%`;
        zoomImg.style.transform = 'scale(1.8)';
      });
      zoom.addEventListener('mouseleave', () => { zoomImg.style.transform = ''; });
    }

    // Copy buy link.
    const copy = root.querySelector<HTMLButtonElement>('[data-copy]');
    copy?.addEventListener('click', async () => {
      const label = copy.querySelector('[data-copy-label]');
      try {
        await navigator.clipboard.writeText(copy.dataset.copy || '');
        if (label) label.textContent = 'Link copied ✓';
      } catch {
        window.prompt('Copy this link:', copy.dataset.copy || '');
      }
      setTimeout(() => { if (label) label.textContent = 'Copy buy link'; }, 1800);
    });

    // QC strip: arrows + segmented progress bar.
    const track = document.querySelector<HTMLElement>('[data-qc-track]');
    const bar = document.querySelector<HTMLElement>('[data-qc-bar]');
    if (track && bar) {
      // clientWidth is 0 while the page is hidden or still laying out.
      const pages = () => (track.clientWidth > 0 ? Math.min(30, Math.max(1, Math.ceil(track.scrollWidth / track.clientWidth - 0.05))) : 1);
      const render = () => {
        const total = pages();
        bar.hidden = total < 2;
        const current = Math.min(total - 1, Math.round(track.scrollLeft / Math.max(1, track.scrollWidth - track.clientWidth) * (total - 1)) || 0);
        bar.innerHTML = Array.from({ length: total }, (_, i) => `<span class="${i === current ? 'is-active' : ''}"></span>`).join('');
      };
      const step = (dir: number) => track.scrollBy({ left: dir * track.clientWidth * 0.85, behavior: 'smooth' });
      document.querySelector('[data-qc-prev]')?.addEventListener('click', () => step(-1));
      document.querySelector('[data-qc-next]')?.addEventListener('click', () => step(1));
      track.addEventListener('scroll', render, { passive: true });
      addEventListener('resize', render);
      render();
    }

    // Lightbox for the main photo and every QC group.
    const box = document.querySelector<HTMLDialogElement>('[data-lightbox]');
    const img = box?.querySelector<HTMLImageElement>('[data-lb-img]');
    const caption = box?.querySelector<HTMLElement>('[data-lb-caption]');
    let list: string[] = [];
    let label = '';
    let index = 0;
    const show = () => {
      if (!img || !caption || !box) return;
      img.src = list[index];
      img.alt = `${data.title} — ${label} ${index + 1}`;
      caption.textContent = list.length > 1 ? `${label} · ${index + 1} / ${list.length}` : label;
      box.classList.toggle('is-single', list.length < 2);
    };
    const open = (images: string[], name: string, start = 0) => {
      if (!box || !images.length) return;
      list = images; label = name; index = start;
      show();
      box.showModal();
    };
    const move = (dir: number) => { if (list.length > 1) { index = (index + dir + list.length) % list.length; show(); } };
    root.querySelector('[data-open-main]')?.addEventListener('click', () => data.main && open([data.main], data.title));
    document.querySelectorAll<HTMLElement>('[data-qc-group]').forEach((card) => {
      card.addEventListener('click', () => {
        const group = data.groups[Number(card.dataset.qcGroup)];
        if (group) open(group.images, group.label);
      });
    });
    box?.querySelector('[data-lb-close]')?.addEventListener('click', () => box.close());
    box?.querySelector('[data-lb-prev]')?.addEventListener('click', () => move(-1));
    box?.querySelector('[data-lb-next]')?.addEventListener('click', () => move(1));
    box?.addEventListener('click', (event) => { if (event.target === box) box.close(); });
    box?.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') move(-1);
      if (event.key === 'ArrowRight') move(1);
    });
  }
</script>
