---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import { catalogMeta, categoryName, formatCatalogCheckedAt, qcCatalogProducts } from '../../lib/catalog';

const products = [...qcCatalogProducts].sort((a, b) => b.qcPhotoCount - a.qcPhotoCount || b.updatedAt.localeCompare(a.updatedAt));
const categories = Object.entries(products.reduce<Record<string, number>>((counts, product) => {
  if (product.category) counts[product.category] = (counts[product.category] || 0) + 1;
  return counts;
}, {})).sort((a, b) => b[1] - a[1]);
const collectionSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `Oopbuy Spreadsheet Finds with QC Photos`,
  url: 'https://oopbuytop.net/finds/',
  description: `Search ${products.length} Oopbuy spreadsheet finds with warehouse QC-photo counts, price context and current-listing checks.`,
  dateModified: catalogMeta.fetchedAt,
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: products.length,
    itemListElement: products.slice(0, 30).map((product, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: product.title,
      url: `https://oopbuytop.net/finds/${product.slug}/`,
    })),
  },
});
---
<BaseLayout
  title={`Oopbuy Spreadsheet Finds: ${products.length} Items with QC Photos | OopbuyTop`}
  description={`Search ${products.length} current Oopbuy spreadsheet finds with warehouse QC-photo counts, price context, categories and individual research pages.`}
>
  <section class="finds-directory-hero">
    <p class="eyebrow">Searchable Oopbuy spreadsheet · checked {formatCatalogCheckedAt()}</p>
    <h1>Oopbuy spreadsheet finds<br /><em>with QC-photo context</em></h1>
    <p>Search the focused set of catalog items that currently have warehouse QC-photo references. Open a result to review its price context, category, update date and live-listing checks.</p>
    <form class="finds-filter" action="/finds/" method="get" data-finds-filter>
      <label>
        <span>Search products or brands</span>
        <input type="search" name="q" placeholder="Try sneakers, perfume, Nike…" autocomplete="off" data-finds-query />
      </label>
      <label>
        <span>Category</span>
        <select name="category" data-finds-category>
          <option value="">All categories</option>
          {categories.map(([slug, count]) => <option value={slug}>{categoryName(slug)} ({count})</option>)}
        </select>
      </label>
      <button type="submit">Search finds</button>
    </form>
    <div class="finds-directory-stats">
      <div><strong>{products.length}</strong><span>finds with QC references</span></div>
      <div><strong>{categories.length}</strong><span>represented categories</span></div>
      <div><strong>Daily</strong><span>catalog refresh workflow</span></div>
    </div>
  </section>

  <section class="finds-directory-results">
    <div class="section-heading">
      <div><p class="eyebrow">Current research set</p><h2>Browse Oopbuy finds</h2></div>
      <p><strong data-results-count>{products.length}</strong> matching finds. QC count is a warehouse-photo signal, not a quality or authenticity grade.</p>
    </div>
    <p class="finds-empty" hidden data-finds-empty>No current QC-reference finds match that search. Try a broader product or brand term.</p>
    <div class="product-grid finds-directory-grid">
      {products.map((product) => (
        <article
          class="finds-directory-card"
          data-find-card
          data-search={`${product.title} ${product.brand ?? ''} ${categoryName(product.category)}`.toLowerCase()}
          data-category={product.category ?? ''}
        >
          <ProductCard product={product} placement="finds_directory" />
        </article>
      ))}
    </div>
  </section>

  <section class="finds-method-note">
    <p class="eyebrow">What is included</p>
    <h2>A smaller, evidence-led spreadsheet view</h2>
    <p>This directory deliberately shows the catalog entries that have a non-zero warehouse QC-photo count and enough current information for a useful research page. It does not claim that the photos prove quality, authenticity, stock or fit. Always confirm the exact live option before ordering.</p>
    <a class="text-link" href="/guides/oopbuy-qc-photos/">How to review Oopbuy QC photos →</a>
  </section>

  <script>
    const filterForm = document.querySelector('[data-finds-filter]');
    const queryInput = document.querySelector('[data-finds-query]');
    const categoryInput = document.querySelector('[data-finds-category]');
    const cards = [...document.querySelectorAll('[data-find-card]')];
    const resultCount = document.querySelector('[data-results-count]');
    const emptyState = document.querySelector('[data-finds-empty]');

    const applyFilters = () => {
      if (!(queryInput instanceof HTMLInputElement) || !(categoryInput instanceof HTMLSelectElement)) return;
      const query = queryInput.value.toLocaleLowerCase().trim();
      const category = categoryInput.value;
      let visible = 0;
      cards.forEach((card) => {
        if (!(card instanceof HTMLElement)) return;
        const matchesQuery = !query || (card.dataset.search ?? '').includes(query);
        const matchesCategory = !category || card.dataset.category === category;
        card.hidden = !(matchesQuery && matchesCategory);
        if (!card.hidden) visible += 1;
      });
      if (resultCount) resultCount.textContent = String(visible);
      if (emptyState instanceof HTMLElement) emptyState.hidden = visible !== 0;
    };

    const params = new URLSearchParams(window.location.search);
    if (queryInput instanceof HTMLInputElement) queryInput.value = params.get('q') ?? '';
    if (categoryInput instanceof HTMLSelectElement) categoryInput.value = params.get('category') ?? '';
    filterForm?.addEventListener('submit', (event) => { event.preventDefault(); applyFilters(); });
    queryInput?.addEventListener('input', applyFilters);
    categoryInput?.addEventListener('change', applyFilters);
    applyFilters();
  </script>
  <script type="application/ld+json" set:html={collectionSchema} />
</BaseLayout>
