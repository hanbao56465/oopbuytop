---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import { catalogCategories, catalogProducts, catalogMeta, formatCatalogCheckedAt, qcCatalogProducts } from '../lib/catalog';
import { trackedOutboundUrl } from '../lib/outbound';
import { priorityCategorySlugs } from '../lib/category-content';
const featured = catalogProducts
  .filter((item) => item.qcPhotoCount > 0 || item.hasTryOn)
  .sort((a, b) => b.qcPhotoCount - a.qcPhotoCount || Number(b.hasTryOn) - Number(a.hasTryOn))
  .slice(0, 10);
const priorityCategories = priorityCategorySlugs.map((slug) => catalogCategories.find((category) => category.slug === slug)).filter(Boolean);
const excludedBrandNames = new Set(['Louis Vuitton']);
const popularBrands = Object.entries(catalogProducts.reduce<Record<string, number>>((brands, item) => { if (item.brand && !excludedBrandNames.has(item.brand)) brands[item.brand] = (brands[item.brand] || 0) + 1; return brands; }, {})).sort((a, b) => b[1] - a[1]).slice(0, 12);
const categoryIcons: Record<string, string> = { 't-shirts': '👕', dresses: '👗', jackets: '🧥', shoes: '👟', heels: '👠', 'trousers-pants': '👖', eyewear: '🕶️', perfume: '🧴', headwear: '🧢', 'underwear-swim': '🩱', electronics: '📱', 'scarves-ties': '🧣', 'jewelry-watches': '💍', 'socks-hosiery': '🧦' };
const localeAlternates = [
  { hreflang: 'x-default', href: 'https://oopbuytop.net/' },
  { hreflang: 'en', href: 'https://oopbuytop.net/' },
  { hreflang: 'de-DE', href: 'https://oopbuytop.net/de/oopbuy-spreadsheet/' },
  { hreflang: 'en-GB', href: 'https://oopbuytop.net/uk/oopbuy-spreadsheet/' },
];
const homeSchema = JSON.stringify({ '@context': 'https://schema.org', '@graph': [{ '@type': 'Organization', name: 'OopbuyTop', url: 'https://oopbuytop.net/', description: 'Independent product-discovery and research resource.' }, { '@type': 'WebSite', name: 'OopbuyTop', url: 'https://oopbuytop.net/', description: 'Searchable Oopbuy spreadsheet with category browsing, current price context, QC-photo counts and buyer guides.', potentialAction: { '@type': 'SearchAction', target: 'https://oopbuytop.net/finds/?q={search_term_string}', 'query-input': 'required name=search_term_string' } }, { '@type': 'CollectionPage', name: 'Oopbuy Spreadsheet 2026', url: 'https://oopbuytop.net/', description: `${catalogMeta.productCount.toLocaleString('en-US')} catalog records with ${qcCatalogProducts.length} focused QC-reference research pages.`, dateModified: catalogMeta.fetchedAt }, { '@type': 'HowTo', name: 'How to use an Oopbuy spreadsheet', step: [{ '@type': 'HowToStep', position: 1, name: 'Search a product or category' }, { '@type': 'HowToStep', position: 2, name: 'Open the research page' }, { '@type': 'HowToStep', position: 3, name: 'Check the live listing' }, { '@type': 'HowToStep', position: 4, name: 'Review QC photos' }] }] });
---
<BaseLayout title={`Oopbuy Spreadsheet 2026: ${catalogMeta.productCount.toLocaleString('en-US')} Finds, QC Photos & Prices`} description={`Search an independent Oopbuy spreadsheet with ${catalogMeta.productCount.toLocaleString('en-US')} catalog records, ${qcCatalogProducts.length} focused QC-reference finds, categories, price context and buyer checks.`} alternates={localeAlternates}>
  <section class="resource-hero"><p class="eyebrow">Oopbuy spreadsheet 2026 · catalog checked {formatCatalogCheckedAt()}</p><h1>Search the Oopbuy spreadsheet<br /><em>finds, prices & QC photos</em></h1><p>Browse {catalogMeta.productCount.toLocaleString('en-US')} catalog records by category and start with {qcCatalogProducts.length} focused finds that currently have warehouse QC-photo references.</p><div class="hero-search-layout"><div class="hero-search-content"><form class="find-search" action="/finds/" method="get"><input type="search" name="q" placeholder="Search a brand or product…" aria-label="Search Oopbuy spreadsheet finds" required /><button type="submit">Search spreadsheet</button></form><p class="search-helper">Search stays on OopbuyTop and opens individual research pages before any external listing.</p><div class="search-hints"><a href="/category/shoes/">Shoes</a><a href="/category/hoodies-sweatshirts/">Hoodies</a><a href="/category/perfume/">Perfume</a><a href="/category/jewelry-watches/">Jewelry</a><a href="/category/electronics/">Tech</a></div></div><figure class="warehouse-mascot"><img src="/warehouse-mascot.png" alt="Warehouse mascot with parcels" width="520" height="380" loading="eager" /><figcaption>Find → compare → check QC</figcaption></figure></div></section>
  <section class="proof-grid" aria-label="Oopbuy spreadsheet catalog facts"><article><strong>{catalogMeta.productCount.toLocaleString('en-US')}</strong><span>CATALOG RECORDS</span></article><article><strong>{qcCatalogProducts.length}</strong><span>QC-REFERENCE FINDS</span></article><article><strong>{catalogMeta.categoryCount}</strong><span>CATALOG CATEGORIES</span></article></section>
  <section class="feature-panel"><p class="eyebrow">Start here</p><div class="section-heading"><div><h2>Popular Oopbuy spreadsheet categories</h2><p class="section-intro">Choose a lane, browse the current listings, then compare photos and options before you buy.</p></div><a class="section-link" href="/categories/">View all categories →</a></div><div class="category-grid category-grid-fourteen neon-categories">{priorityCategories.map((category) => category && <a class="category-card" href={`/category/${category.slug}/`}><span class="category-number">{String(priorityCategories.indexOf(category) + 1).padStart(2, '0')}</span><b class="category-icon" aria-hidden="true">{categoryIcons[category.slug]}</b><strong>{category.name}</strong><span>Browse finds <b>→</b></span></a>)}</div></section>
  <section class="finds-section"><div class="section-heading"><div><p class="eyebrow">Fresh picks</p><h2>Oopbuy spreadsheet finds with QC photos</h2></div><a class="section-link" href="/finds/">Search all QC-reference finds →</a></div><div class="product-grid">{featured.map((product) => <ProductCard product={product} placement="homepage_qc_card" />)}</div></section>
  <section class="trust-panel"><p class="eyebrow">Before you order</p><h2>Use finds as a starting point, not a final decision.</h2><p>Check the live listing, measurements, seller photos, variants, and shipping option yourself. OopbuyTop is an independent discovery resource; it does not sell products or process orders. This catalog snapshot was checked on {formatCatalogCheckedAt()} and contains {catalogMeta.productCount.toLocaleString('en-US')} product records across {catalogMeta.categoryCount} categories.</p><a class="text-link" href="/guides/">Read the buying guides →</a></section>
  <section class="browse-hubs"><div class="section-heading"><div><p class="eyebrow">Find your lane</p><h2>Browse popular brands</h2><p class="section-intro">Start with a brand, then compare the current listing, price range and QC availability.</p></div><a class="section-link" href="/finds/">Search QC finds →</a></div><div class="brand-grid">{popularBrands.map(([brand, count]) => <a class="brand-chip" href={`/finds/?q=${encodeURIComponent(brand)}`}><span>{brand}</span><small>{count} catalog records</small></a>)}</div></section>
  <section class="country-guide-panel"><div><p class="eyebrow">Local research paths</p><h2>Country-specific Oopbuy spreadsheet guides</h2><p>Use a local guide for currency context, destination checks and focused category shortcuts. Current checkout and carrier information always takes precedence.</p></div><div class="country-guide-links"><a href="/de/oopbuy-spreadsheet/" lang="de"><strong>Deutschland</strong><span>Oopbuy Spreadsheet auf Deutsch →</span></a><a href="/uk/oopbuy-spreadsheet/" lang="en-GB"><strong>United Kingdom</strong><span>UK spreadsheet and parcel checks →</span></a></div></section>
  <section class="buyer-flow" id="how-it-works"><p class="eyebrow">Clear before checkout</p><h2>How to use an Oopbuy spreadsheet</h2><p class="buyer-flow-intro">Use the spreadsheet to discover and compare; verify the live details before every order or shipping decision.</p><ol><li><b>01</b><div><strong>Browse a focused category</strong><span>Use products, brands and QC availability to build a shortlist.</span><a class="flow-link" href="/categories/">Browse categories →</a></div></li><li><b>02</b><div><strong>Compare the live listing</strong><span>Check the current size, variant, seller photos and price.</span><a class="flow-link" href={trackedOutboundUrl('https://maisonlooks.com', 'homepage_flow_cta')} target="_blank" rel="sponsored noopener noreferrer">Open live finds ↗</a></div></li><li><b>03</b><div><strong>Review warehouse QC</strong><span>Compare warehouse photos before an item enters a parcel.</span><a class="flow-link" href="/guides/oopbuy-qc-photos/">Check QC photos →</a></div></li><li><b>04</b><div><strong>Plan shipping carefully</strong><span>Read the current options for your destination at checkout.</span><a class="flow-link" href="/guides/oopbuy-shipping-guide/">Read shipping guide →</a></div></li></ol><a class="button button-hot" href="/categories/">Browse Oopbuy spreadsheet finds <span>→</span></a><p class="buyer-flow-note">OopbuyTop is an independent discovery resource. Product availability, QC images and shipping options can change.</p></section>
  <script type="application/ld+json" set:html={homeSchema} />
</BaseLayout>
