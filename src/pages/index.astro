---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import { catalogCategories, catalogProducts, catalogMeta, formatCatalogCheckedAt } from '../lib/catalog';
import { priorityCategorySlugs } from '../lib/category-content';
const featured = catalogProducts
  .filter((item) => item.qcPhotoCount > 0 || item.hasTryOn)
  .sort((a, b) => b.qcPhotoCount - a.qcPhotoCount || Number(b.hasTryOn) - Number(a.hasTryOn))
  .slice(0, 10);
const priorityCategories = priorityCategorySlugs.map((slug) => catalogCategories.find((category) => category.slug === slug)).filter(Boolean);
const excludedBrandNames = new Set(['Louis Vuitton']);
const popularBrands = Object.entries(catalogProducts.reduce<Record<string, number>>((brands, item) => { if (item.brand && !excludedBrandNames.has(item.brand)) brands[item.brand] = (brands[item.brand] || 0) + 1; return brands; }, {})).sort((a, b) => b[1] - a[1]).slice(0, 12);
const homeProductSearchIndex = catalogProducts.filter((item) => item.title && item.slug).map(({ title, slug }) => ({ title, slug }));
const homeBrandSearchIndex = [...new Set(catalogProducts.map((item) => item.brand).filter(Boolean))] as string[];
const categoryIcons: Record<string, string> = { 't-shirts': '👕', dresses: '👗', jackets: '🧥', shoes: '👟', heels: '👠', 'trousers-pants': '👖', eyewear: '🕶️', perfume: '🧴', headwear: '🧢', 'underwear-swim': '🩱', electronics: '📱', 'scarves-ties': '🧣', 'jewelry-watches': '💍', 'socks-hosiery': '🧦' };
const homeSchema = JSON.stringify({ '@context': 'https://schema.org', '@graph': [{ '@type': 'Organization', name: 'OopbuyTop', url: 'https://oopbuytop.net/', description: 'Independent product-discovery and research resource.' }, { '@type': 'WebSite', name: 'OopbuyTop', url: 'https://oopbuytop.net/', description: 'Independent Oopbuy spreadsheet guide with category browsing, QC photo counts and buyer guides.' }, { '@type': 'HowTo', name: 'How to use an Oopbuy spreadsheet', step: [{ '@type': 'HowToStep', position: 1, name: 'Browse a category' }, { '@type': 'HowToStep', position: 2, name: 'Check the live listing' }, { '@type': 'HowToStep', position: 3, name: 'Review QC photos' }, { '@type': 'HowToStep', position: 4, name: 'Choose shipping' }] }] });
---
<BaseLayout title="Oopbuy Spreadsheet: Finds, QC & Guides | OopbuyTop" description="Explore an independent Oopbuy spreadsheet for current finds, category browsing, QC photo counts and practical buyer guides. Compare details before you order.">
  <section class="resource-hero"><p class="eyebrow">Independent Oopbuy discovery hub · catalog checked {formatCatalogCheckedAt()}</p><h1>Oopbuy spreadsheet<br /><em>finds, QC & buyer guides</em></h1><p>Browse by category, check the QC count on each find, then open the current listing when you are ready to compare it.</p><div class="hero-search-layout"><div class="hero-search-content"><form class="find-search" action="https://maisonlooks.com/en/products" method="get" target="_blank" data-maison-search><input type="search" name="search" placeholder="Search a brand or product…" aria-label="Search live listings by brand or product" required data-maison-search-input /><button type="submit">Search finds</button></form><p class="search-helper">Exact product names open the matching listing. Brand names open the live brand results.</p><div class="search-hints"><a href="/category/shoes/">Shoes</a><a href="/category/jackets/">Jackets</a><a href="/category/dresses/">Dresses</a><a href="/category/jewelry-watches/">Jewelry</a><a href="/category/electronics/">Tech</a></div></div><figure class="warehouse-mascot"><img src="/warehouse-mascot.png" alt="Warehouse mascot with parcels" width="520" height="380" loading="eager" /><figcaption>Find → compare → check QC</figcaption></figure></div></section>
  <section class="feature-panel"><p class="eyebrow">Start here</p><div class="section-heading"><div><h2>Popular Oopbuy spreadsheet categories</h2><p class="section-intro">Choose a lane, browse the current listings, then compare photos and options before you buy.</p></div><a class="section-link" href="/categories/">View all categories →</a></div><div class="category-grid category-grid-fourteen neon-categories">{priorityCategories.map((category) => category && <a class="category-card" href={`/category/${category.slug}/`}><span class="category-number">{String(priorityCategories.indexOf(category) + 1).padStart(2, '0')}</span><b class="category-icon" aria-hidden="true">{categoryIcons[category.slug]}</b><strong>{category.name}</strong><span>Browse finds <b>→</b></span></a>)}</div></section>
  <section class="finds-section"><div class="section-heading"><div><p class="eyebrow">Fresh picks</p><h2>Oopbuy spreadsheet finds with QC photos</h2></div><a class="section-link" href="https://maisonlooks.com" rel="sponsored">Browse live finds ↗</a></div><div class="product-grid">{featured.map((product) => <ProductCard product={product} />)}</div></section>
  <section class="trust-panel"><p class="eyebrow">Before you order</p><h2>Use finds as a starting point, not a final decision.</h2><p>Check the live listing, measurements, seller photos, variants, and shipping option yourself. OopbuyTop is an independent discovery resource; it does not sell products or process orders. This catalog snapshot was checked on {formatCatalogCheckedAt()} and contains {catalogMeta.productCount.toLocaleString('en-US')} product records across {catalogMeta.categoryCount} categories.</p><a class="text-link" href="/guides/">Read the buying guides →</a></section>
  <section class="browse-hubs"><div class="section-heading"><div><p class="eyebrow">Find your lane</p><h2>Browse popular brands</h2><p class="section-intro">Start with a brand, then compare the current listing, price range and QC availability.</p></div><a class="section-link" href="/categories/">All categories →</a></div><div class="brand-grid">{popularBrands.map(([brand, count]) => <a class="brand-chip" href={`/categories/?brand=${encodeURIComponent(brand)}`}><span>{brand}</span><small>{count} finds</small></a>)}</div></section>
  <section class="buyer-flow" id="how-it-works"><p class="eyebrow">Clear before checkout</p><h2>How to use an Oopbuy spreadsheet</h2><p class="buyer-flow-intro">Use the spreadsheet to discover and compare; verify the live details before every order or shipping decision.</p><ol><li><b>01</b><div><strong>Browse a focused category</strong><span>Use products, brands and QC availability to build a shortlist.</span><a class="flow-link" href="/categories/">Browse categories →</a></div></li><li><b>02</b><div><strong>Compare the live listing</strong><span>Check the current size, variant, seller photos and price.</span><a class="flow-link" href="https://maisonlooks.com" rel="sponsored">Open live finds ↗</a></div></li><li><b>03</b><div><strong>Review warehouse QC</strong><span>Compare warehouse photos before an item enters a parcel.</span><a class="flow-link" href="/guides/oopbuy-qc-photos/">Check QC photos →</a></div></li><li><b>04</b><div><strong>Plan shipping carefully</strong><span>Read the current options for your destination at checkout.</span><a class="flow-link" href="/guides/oopbuy-shipping-guide/">Read shipping guide →</a></div></li></ol><a class="button button-hot" href="/categories/">Browse Oopbuy spreadsheet finds <span>→</span></a><p class="buyer-flow-note">OopbuyTop is an independent discovery resource. Product availability, QC images and shipping options can change.</p></section>
  <script define:vars={{ homeProductSearchIndex, homeBrandSearchIndex }}>
    const normalizeSearchTerm = (value) => String(value ?? '').toLocaleLowerCase().replace(/[^a-z0-9]+/g, ' ').trim();
    const maisonSearchForm = document.querySelector('[data-maison-search]');
    const maisonSearchInput = document.querySelector('[data-maison-search-input]');

    maisonSearchForm?.addEventListener('submit', (event) => {
      event.preventDefault();
      const query = maisonSearchInput?.value.trim();
      if (!query) return;

      const normalizedQuery = normalizeSearchTerm(query);
      const exactProduct = homeProductSearchIndex.find((product) => normalizeSearchTerm(product.title) === normalizedQuery);
      const exactBrand = homeBrandSearchIndex.find((brand) => {
        const normalizedBrand = normalizeSearchTerm(brand);
        return normalizedBrand === normalizedQuery || normalizedBrand.includes(normalizedQuery);
      });
      const destination = exactProduct
        ? `https://maisonlooks.com/en/p/${encodeURIComponent(exactProduct.slug)}`
        : exactBrand
          ? `https://maisonlooks.com/en/products?brands=${encodeURIComponent(exactBrand.toLowerCase())}`
          : `https://maisonlooks.com/en/products?search=${encodeURIComponent(query)}`;

      window.open(destination, '_blank', 'noopener');
    });
  </script>
  <script type="application/ld+json" set:html={homeSchema} />
</BaseLayout>
