---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import { catalogCategories, catalogProducts, catalogMeta } from '../lib/catalog';
import { priorityCategorySlugs } from '../lib/category-content';
const featured = catalogProducts.filter((item) => item.qcPhotoCount > 0 || item.hasTryOn).slice(0, 10);
const priorityCategories = priorityCategorySlugs.map((slug) => catalogCategories.find((category) => category.slug === slug)).filter(Boolean);
const popularBrands = Object.entries(catalogProducts.reduce<Record<string, number>>((brands, item) => { if (item.brand) brands[item.brand] = (brands[item.brand] || 0) + 1; return brands; }, {})).sort((a, b) => b[1] - a[1]).slice(0, 12);
const homeSchema = JSON.stringify({ '@context': 'https://schema.org', '@graph': [{ '@type': 'WebSite', name: 'OopbuyTop', url: 'https://oopbuytop.net/', description: 'Independent Oopbuy spreadsheet guide with category browsing, QC photo counts and buyer guides.' }, { '@type': 'HowTo', name: 'How to use an Oopbuy spreadsheet', step: [{ '@type': 'HowToStep', position: 1, name: 'Browse a category' }, { '@type': 'HowToStep', position: 2, name: 'Check the live listing' }, { '@type': 'HowToStep', position: 3, name: 'Review QC photos' }, { '@type': 'HowToStep', position: 4, name: 'Choose shipping' }] }] });
---
<BaseLayout title="Oopbuy Spreadsheet: Finds, QC Photos & Buyer Guides (2026) | OopbuyTop" description="Explore an independent Oopbuy spreadsheet for current finds, category browsing, QC photo counts and practical buyer guides. Compare details before you order.">
  <section class="resource-hero"><p class="eyebrow">Independent Oopbuy discovery hub · updated 2026</p><h1>Oopbuy spreadsheet<br /><em>finds, QC & buyer guides</em></h1><p>Browse by category, check the QC count on each find, then open the current listing when you are ready to compare it.</p><form class="find-search" action="/categories/"><input type="search" name="q" placeholder="Search categories: sneakers, hoodies, bags…" /><button type="submit">Browse finds</button></form><div class="search-hints"><a href="/category/sneakers/">Sneakers</a><a href="/category/hoodies-sweatshirts/">Hoodies</a><a href="/category/bags-backpacks/">Bags</a><a href="/category/jewelry-watches/">Jewelry</a><a href="/category/phone-accessories/">Tech</a></div></section>
  <section class="feature-panel"><p class="eyebrow">Start here</p><div class="section-heading"><div><h2>Popular Oopbuy spreadsheet categories</h2><p class="section-intro">Choose a lane, browse the current listings, then compare photos and options before you buy.</p></div><a class="section-link" href="/categories/">View all categories →</a></div><div class="category-grid neon-categories">{priorityCategories.map((category) => category && <a class="category-card" href={`/category/${category.slug}/`}><span class="category-number">0{priorityCategories.indexOf(category) + 1}</span><strong>{category.name}</strong><span>{category.productCount ? `${category.productCount.toLocaleString()} finds` : 'Browse finds'} <b>→</b></span></a>)}</div></section>
  <section class="finds-section"><div class="section-heading"><div><p class="eyebrow">Fresh picks</p><h2>Oopbuy spreadsheet finds with QC photos</h2></div><a class="section-link" href="https://maisonlooks.com" rel="sponsored">Open MaisonLooks ↗</a></div><div class="product-grid">{featured.map((product) => <ProductCard product={product} />)}</div></section>
  <section class="trust-panel"><p class="eyebrow">Before you order</p><h2>Use finds as a starting point, not a final decision.</h2><p>Check the live listing, measurements, seller photos, variants, and shipping option yourself. OopbuyTop is an independent discovery resource; it does not sell products or process orders. Catalog snapshot: {new Date(catalogMeta.fetchedAt).toLocaleDateString('en-US', { month: 'long', year: 'numeric' })}.</p><a class="text-link" href="/guides/">Read the buying guides →</a></section>
  <section class="browse-hubs"><div class="section-heading"><div><p class="eyebrow">Find your lane</p><h2>Browse popular brands</h2><p class="section-intro">Start with a brand, then compare the current listing, price range and QC availability.</p></div><a class="section-link" href="/categories/">All categories →</a></div><div class="brand-grid">{popularBrands.map(([brand, count]) => <a class="brand-chip" href={`/categories/?brand=${encodeURIComponent(brand)}`}><span>{brand}</span><small>{count} finds</small></a>)}</div></section>
  <section class="buyer-flow" id="how-it-works"><p class="eyebrow">Clear before checkout</p><h2>From discovery to delivery</h2><ol><li><b>01</b><div><strong>Browse a focused category</strong><span>Use products, brands and QC availability to shortlist items.</span></div></li><li><b>02</b><div><strong>Open the live listing</strong><span>Check size, variant, seller photos and the latest price.</span></div></li><li><b>03</b><div><strong>Review warehouse QC</strong><span>Use QC photos before you approve an item for shipping.</span></div></li><li><b>04</b><div><strong>Choose shipping carefully</strong><span>Compare shipping options and track the parcel after dispatch.</span></div></li></ol><a class="button button-hot" href="/guides/">Read buyer guides <span>→</span></a></section>
  <script type="application/ld+json" set:html={homeSchema} />
</BaseLayout>
