---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import { catalogCategories, catalogProducts, catalogMeta } from '../lib/catalog';
import { priorityCategorySlugs } from '../lib/category-content';
const featured = catalogProducts.filter((item) => item.qcPhotoCount > 0 || item.hasTryOn).slice(0, 6);
const priorityCategories = priorityCategorySlugs.map((slug) => catalogCategories.find((category) => category.slug === slug)).filter(Boolean);
const qcTotal = catalogProducts.reduce((sum, item) => sum + (item.qcPhotoCount || 0), 0);
---
<BaseLayout title="Oopbuy Spreadsheet & Finds Guide (2026) | OopbuyTop" description="Browse Oopbuy spreadsheet categories, practical buyer guides, and current product discovery links.">
  <section class="neon-hero"><p class="hero-kicker">Oopbuy spreadsheet</p><h1>Find better picks.<br /><span>Check the details first.</span></h1><p class="hero-copy">A focused discovery guide for Oopbuy-style finds, with real categories, product context, and simple buying checks.</p><div class="hero-actions"><a class="button button-hot" href="/categories/">Browse latest finds <span>→</span></a><a class="button button-ghost" href="/oopbuy-spreadsheet/">How this guide works <span>↗</span></a></div></section>
  <section class="proof-grid" aria-label="Catalog highlights"><article><strong>{catalogProducts.length.toLocaleString()}+</strong><span>CURATED FINDS</span></article><article><strong>{catalogCategories.length}</strong><span>LIVE CATEGORIES</span></article><article><strong>{qcTotal.toLocaleString()}+</strong><span>QC PHOTOS INDEXED</span></article></section>
  <section class="feature-panel"><p class="eyebrow">Start here</p><div class="section-heading"><div><h2>Popular find categories</h2><p class="section-intro">Choose a lane, browse the current listings, then compare photos and options before you buy.</p></div><a class="section-link" href="/categories/">View all categories →</a></div><div class="category-grid neon-categories">{priorityCategories.map((category) => category && <a class="category-card" href={`/category/${category.slug}/`}><span class="category-number">0{priorityCategories.indexOf(category) + 1}</span><strong>{category.name}</strong><span>{category.productCount ? `${category.productCount.toLocaleString()} finds` : 'Browse finds'} <b>→</b></span></a>)}</div></section>
  <section class="finds-section"><div class="section-heading"><div><p class="eyebrow">Fresh picks</p><h2>Explore the current catalog</h2></div><a class="section-link" href="https://maisonlooks.com" rel="sponsored">Open MaisonLooks ↗</a></div><div class="product-grid">{featured.map((product) => <ProductCard product={product} />)}</div></section>
  <section class="trust-panel"><p class="eyebrow">Before you order</p><h2>Use finds as a starting point, not a final decision.</h2><p>Check the live listing, measurements, seller photos, variants, and shipping option yourself. OopbuyTop is an independent discovery resource; it does not sell products or process orders. Catalog snapshot: {new Date(catalogMeta.fetchedAt).toLocaleDateString('en-US', { month: 'long', year: 'numeric' })}.</p><a class="text-link" href="/guides/">Read the buying guides →</a></section>
</BaseLayout>
