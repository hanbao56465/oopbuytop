---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import { catalogMeta, formatCatalogCheckedAt, qcCatalogProducts } from '../../lib/catalog';
import { priorityFindProducts } from '../../lib/find-content';
import { countryAlternates } from '../../lib/country-seo';

const focusProducts: typeof priorityFindProducts = [];
for (const category of ['perfume', 'sneakers', 'hoodies-sweatshirts', 'jackets', 'loafers-flats', 'belts', 'boots']) {
  const product = priorityFindProducts.find((item) => item.category === category && !focusProducts.some((selected) => selected.slug === item.slug));
  if (product) focusProducts.push(product);
  if (focusProducts.length >= 6) break;
}
for (const product of priorityFindProducts) {
  if (focusProducts.length >= 6) break;
  if (!focusProducts.some((selected) => selected.slug === product.slug)) focusProducts.push(product);
}
const canonical = 'https://oopbuytop.net/de/oopbuy-spreadsheet/';
const faq = [
  { question: 'Ist diese Oopbuy Spreadsheet speziell für Deutschland?', answer: 'Diese Seite bündelt deutschsprachige Recherchehinweise und passende Kategorien. Preise, Versandwege, Einfuhrabgaben und Verfügbarkeit müssen immer im aktuellen Checkout für das eigene Ziel geprüft werden.' },
  { question: 'Sind die Preise bereits in Euro und inklusive Versand?', answer: 'Nein. Die angezeigten Produktpreise sind Momentaufnahmen und keine Endpreise. Währungskurs, gewählte Variante, Versand, Versicherung und mögliche Abgaben können den Gesamtbetrag verändern.' },
  { question: 'Was bedeutet die Anzahl der QC-Fotos?', answer: 'Sie zeigt nur, wie viele Lagerfoto-Referenzen der Katalog zum Zeitpunkt der Aktualisierung gemeldet hat. Sie ist keine Qualitätsnote und keine Echtheitsgarantie.' },
  { question: 'Wie finde ich passende Größen?', answer: 'Vergleiche die aktuellen Produktmaße mit einem eigenen Kleidungsstück oder Schuh, das gut passt. Verlasse dich nicht ausschließlich auf internationale Größenangaben.' },
];
const schema = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebPage', name: 'Oopbuy Spreadsheet Deutschland 2026', url: canonical, inLanguage: 'de-DE', description: `Deutschsprachige Oopbuy Spreadsheet mit ${catalogMeta.productCount.toLocaleString('de-DE')} Katalogeinträgen und ${qcCatalogProducts.length} ausgewählten QC-Fundstücken.`, dateModified: catalogMeta.fetchedAt },
    { '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Oopbuy Spreadsheet', item: 'https://oopbuytop.net/' }, { '@type': 'ListItem', position: 2, name: 'Deutschland', item: canonical }] },
    { '@type': 'ItemList', name: 'Oopbuy Funde für die Deutschland-Recherche', numberOfItems: focusProducts.length, itemListElement: focusProducts.map((product, index) => ({ '@type': 'ListItem', position: index + 1, name: product?.title, url: `https://oopbuytop.net/finds/${product?.slug}/` })) },
    { '@type': 'FAQPage', mainEntity: faq.map((item) => ({ '@type': 'Question', name: item.question, acceptedAnswer: { '@type': 'Answer', text: item.answer } })) },
  ],
});
---
<BaseLayout
  lang="de-DE"
  title="Oopbuy Spreadsheet Deutschland 2026: Funde, Preise & QC"
  description={`Oopbuy Spreadsheet Deutschland mit ${catalogMeta.productCount.toLocaleString('de-DE')} Katalogeinträgen, ${qcCatalogProducts.length} QC-Fundstücken, Preis-Kontext sowie Größen- und Versandchecks.`}
  canonical={canonical}
  alternates={countryAlternates}
>
  <nav class="locale-breadcrumbs" aria-label="Brotkrümelnavigation"><a href="/">Oopbuy Spreadsheet</a><span>›</span><span>Deutschland</span></nav>
  <section class="locale-hero locale-hero-de">
    <div><p class="eyebrow">Deutschland · geprüft am {formatCatalogCheckedAt('de-DE')}</p><h1>Oopbuy Spreadsheet Deutschland:<br /><em>Funde mit Preis- und QC-Kontext</em></h1><p>Durchsuche einen unabhängigen Katalog mit {catalogMeta.productCount.toLocaleString('de-DE')} Einträgen. Beginne mit {qcCatalogProducts.length} Fundstücken, für die aktuell Lagerfoto-Referenzen gemeldet sind, und prüfe anschließend immer die Live-Variante.</p><div class="locale-actions"><a class="button button-hot" href="/finds/">QC-Funde durchsuchen →</a><a class="text-link" href="/category/perfume/">Parfüm-Funde ansehen</a></div></div>
    <aside><strong>Wichtig für Deutschland</strong><ul><li>Produktpreis ist nicht der endgültige Paketpreis.</li><li>Maße statt vertrauter Größenetiketten vergleichen.</li><li>Aktuelle Versand- und Einfuhrinformationen im Checkout prüfen.</li></ul></aside>
  </section>

  <section class="locale-proof" aria-label="Katalogdaten"><article><strong>{catalogMeta.productCount.toLocaleString('de-DE')}</strong><span>KATALOGEINTRÄGE</span></article><article><strong>{qcCatalogProducts.length}</strong><span>QC-REFERENZSEITEN</span></article><article><strong>€</strong><span>ENDPREIS SEPARAT PRÜFEN</span></article></section>

  <section class="locale-content-grid">
    <article><p class="eyebrow">Schritt 1</p><h2>Die Spreadsheet als Recherche verwenden</h2><p>Suche zuerst nach Produkttyp, Marke oder Modell und öffne anschließend nur wenige passende Einträge. Vergleiche Titel, ausgewählte Variante, aktuelle Bilder und Maße auf der Live-Seite. Eine lange Liste ist weniger hilfreich als eine kurze Auswahl mit klaren Daten.</p><p>Der Katalog ist eine Momentaufnahme. Er verkauft keine Produkte und bestätigt weder Echtheit noch Bestand oder Qualität.</p></article>
    <article><p class="eyebrow">Schritt 2</p><h2>Größe und Option dokumentieren</h2><p>Bei Kleidung sind Brustweite, Länge, Schulter und Ärmel entscheidend. Bei Schuhen sind Innen- oder Einlegesohlenlänge nützlicher als ein EU-Größenetikett. Notiere Farbe, Größe und Variante, damit die späteren Lagerfotos mit der Bestellung verglichen werden können.</p><a class="text-link" href="/guides/oopbuy-size-guide/">Englischen Größenleitfaden öffnen →</a></article>
    <article><p class="eyebrow">Schritt 3</p><h2>Euro- und Versandkontext trennen</h2><p>Der Produktpreis kann sich durch Variante und Wechselkurs ändern. Versand, Versicherung, optionale Services und mögliche Einfuhrkosten gehören nicht automatisch zum angezeigten Betrag. Verwende für die Entscheidung ausschließlich die aktuellen Angaben für deine Adresse.</p><a class="text-link" href="/guides/oopbuy-shipping-guide/">Versand-Checkliste öffnen →</a></article>
  </section>

  <section class="locale-category-links"><div><p class="eyebrow">Beliebte Einstiege</p><h2>Oopbuy Spreadsheet Kategorien</h2></div><div><a href="/category/perfume/">Parfüm</a><a href="/category/hoodies-sweatshirts/">Hoodies</a><a href="/category/shoes/">Schuhe</a><a href="/category/jackets/">Jacken</a><a href="/category/belts/">Gürtel</a><a href="/category/electronics/">Elektronik</a></div></section>

  <section class="finds-section"><div class="section-heading"><div><p class="eyebrow">Ausgewählte Recherche-Seiten</p><h2>Funde mit aktuellen QC-Referenzen</h2><p class="section-intro">Die Karten führen zuerst zu einer internen Prüfseite und nicht direkt zu einer externen Produktseite.</p></div><a class="section-link" href="/finds/">Alle QC-Funde →</a></div><div class="product-grid">{focusProducts.map((product) => product && <ProductCard product={product} placement="de_spreadsheet" />)}</div></section>

  <section class="locale-faq"><p class="eyebrow">Häufige Fragen</p><h2>Oopbuy Spreadsheet Deutschland</h2>{faq.map((item) => <details><summary>{item.question}</summary><p>{item.answer}</p></details>)}</section>
  <script type="application/ld+json" set:html={schema} />
</BaseLayout>
