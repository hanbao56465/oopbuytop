---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { catalogMeta, categoryName, formatCatalogCheckedAt } from '../../lib/catalog';
import { brandPageForSlug, catalogBrands } from '../../lib/brands';

export function getStaticPaths() {
  return catalogBrands.map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const page = entry ?? brandPageForSlug(Astro.params.slug || '');
if (!page) throw new Error('Brand page not found');

const products = page.products.slice(0, 24);
const categories = Object.entries(
  page.products.reduce<Record<string, number>>((counts, product) => {
    if (product.category) counts[product.category] = (counts[product.category] || 0) + 1;
    return counts;
  }, {}),
).sort((a, b) => b[1] - a[1]).slice(0, 6);

const title = `${page.brand} Oopbuy Spreadsheet Finds with QC Photos (${page.productCount}) | OopbuyTop`;
const description = `Browse ${page.productCount} ${page.brand} finds in the Oopbuy spreadsheet with warehouse QC photos and price context. Compare options, then verify the live listing before you order.`;
const pageUrl = `https://oopbuytop.net/brand/${page.slug}/`;
const schema = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      name: `${page.brand} Oopbuy spreadsheet finds with QC photos`,
      url: pageUrl,
      description,
      dateModified: catalogMeta.fetchedAt,
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://oopbuytop.net/' },
        { '@type': 'ListItem', position: 2, name: 'Spreadsheet brands', item: 'https://oopbuytop.net/brands/' },
        { '@type': 'ListItem', position: 3, name: page.brand, item: pageUrl },
      ],
    },
    {
      '@type': 'ItemList',
      name: `${page.brand} Oopbuy spreadsheet QC finds`,
      numberOfItems: products.length,
      itemListElement: products.map((product, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: product.title,
        url: `https://oopbuytop.net/finds/${product.slug}/`,
      })),
    },
    {
      '@type': 'FAQPage',
      mainEntity: [
        {
          '@type': 'Question',
          name: `Are these official ${page.brand} products?`,
          acceptedAnswer: {
            '@type': 'Answer',
            text: `No. This page lists independent Oopbuy spreadsheet research finds labelled ${page.brand} in the catalogue snapshot. OopbuyTop does not authenticate products or sell them.`,
          },
        },
        {
          '@type': 'Question',
          name: `Do ${page.brand} QC photos guarantee quality?`,
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'No. A QC-photo count only means warehouse reference images are available. Compare them with the selected option; they do not prove authenticity, fit or durability.',
          },
        },
        {
          '@type': 'Question',
          name: `How should I use a ${page.brand} Oopbuy spreadsheet find?`,
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Open the spreadsheet research page for price and QC context, then verify the exact live listing, size or configuration before ordering or shipping.',
          },
        },
      ],
    },
  ],
});
---
<BaseLayout title={title} description={description}>
  <Breadcrumbs items={[{ label: 'Spreadsheet brands', href: '/brands/' }, { label: page.brand }]} />
  <section class="hero compact">
    <p class="eyebrow">{page.productCount} QC-reference finds · checked {formatCatalogCheckedAt()}</p>
    <h1>{page.brand} Oopbuy spreadsheet<br /><em>finds with QC photos</em></h1>
    <p>
      Compare current {page.brand} rows in the Oopbuy spreadsheet that report warehouse QC-photo references.
      Use this brand lane for a short shortlist, then verify the selected live option before any order or parcel decision.
    </p>
    <div class="locale-actions">
      <a class="button button-hot" href={`/finds/?q=${encodeURIComponent(page.brand)}`}>Search {page.brand} spreadsheet finds →</a>
      <a class="text-link" href="/finds/">Oopbuy spreadsheet with QC</a>
    </div>
  </section>

  {categories.length > 0 && (
    <section class="locale-category-links">
      <div>
        <p class="eyebrow">Inside this brand</p>
        <h2>{page.brand} categories in the current snapshot</h2>
      </div>
      <div>
        {categories.map(([slug, count]) => (
          <a href={`/category/${slug}/`}>{categoryName(slug)} · {count}</a>
        ))}
      </div>
    </section>
  )}

  <section class="finds-section">
    <div class="section-heading">
      <div>
        <p class="eyebrow">QC-first shortlist</p>
        <h2>{page.brand} spreadsheet finds with warehouse QC photos</h2>
        <p class="section-intro">
          Sorted by QC-photo count inside this Oopbuy spreadsheet brand lane. Open a card for research details; treat brand labels as catalogue metadata, not authenticity claims.
        </p>
      </div>
      <a class="section-link" href="/brands/">All brands →</a>
    </div>
    <div class="product-grid">
      {products.map((product) => <ProductCard product={product} hideMissingQc placement={`brand_${page.slug}`} />)}
    </div>
  </section>

  <section class="notice">
    <h2>Before you order a {page.brand} find</h2>
    <ul>
      <li>Confirm the exact colour, size or configuration on the live listing.</li>
      <li>Compare measurements or specifications with an item you already own.</li>
      <li>Review warehouse QC photos against the selected option before shipping.</li>
    </ul>
    <p>
      <a class="text-link" href="/guides/oopbuy-qc-photos/">QC photo guide →</a>
      {' · '}
      <a class="text-link" href="/oopbuy-spreadsheet/">How to use the spreadsheet →</a>
    </p>
  </section>

  <section class="guide-faq category-faq">
    <p class="eyebrow">Brand FAQ</p>
    <h2>{page.brand} Oopbuy research questions</h2>
    <details>
      <summary>Are these official {page.brand} products?</summary>
      <p>No. This page lists independent catalogue finds labelled {page.brand}. OopbuyTop does not authenticate or sell products.</p>
    </details>
    <details>
      <summary>Do {page.brand} QC photos guarantee quality?</summary>
      <p>No. They provide visible warehouse references only and do not prove authenticity, fit or durability.</p>
    </details>
    <details>
      <summary>How should I use a {page.brand} find page?</summary>
      <p>Use it for discovery and QC context, then verify the current live listing before ordering or building a parcel.</p>
    </details>
  </section>
  <script type="application/ld+json" set:html={schema} />
</BaseLayout>
