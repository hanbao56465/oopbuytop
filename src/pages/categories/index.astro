---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { catalogCategories, categoryImage } from '../../lib/catalog';
import { searchCategorySlugs } from '../../lib/category-content';
const icons: Record<string, string> = { 't-shirts': '👕', dresses: '👗', jackets: '🧥', shoes: '👟', heels: '👠', 'trousers-pants': '👖', eyewear: '🕶️', perfume: '🧴', headwear: '🧢', 'underwear-swim': '🩱', electronics: '📱', 'scarves-ties': '🧣', 'jewelry-watches': '💍', 'socks-hosiery': '🧦' };
const labels: Record<string, string> = { shoes: 'Shoes', heels: 'High Heels', 'trousers-pants': 'Pants', eyewear: 'Sunglasses', headwear: 'Hats', 'underwear-swim': 'Underwear', 'scarves-ties': 'Scarves', 'jewelry-watches': 'Jewelry', 'socks-hosiery': 'Socks' };
const usedCategoryPhotos = new Set<string>();
const categories = searchCategorySlugs.map((slug) => catalogCategories.find((category) => category.slug === slug)).filter(Boolean);
---
<BaseLayout title="Oopbuy Spreadsheet Categories: Shoes, Hoodies, Perfume & More | OopbuyTop" description="Browse Oopbuy spreadsheet categories for shoes, hoodies, perfume, sneakers, bags and more. Compare focused spreadsheet finds with QC photos, then verify the live listing.">
 <section class="hero compact"><p class="eyebrow">Oopbuy spreadsheet navigation</p><h1>Oopbuy spreadsheet categories</h1><p>Pick one product type—shoes, hoodies, perfume, sneakers, bags and more—then compare focused spreadsheet finds with QC-photo context. For the method, read <a href="/guides/oopbuy-spreadsheet-categories/">how to browse spreadsheet categories</a>; for the full workflow, use the <a href="/oopbuy-spreadsheet/">how-to-use guide</a>.</p></section>
 <section><div class="category-grid category-grid-fourteen">{categories.map((category) => category && <a class="category-card" href={`/category/${category.slug}/`}>{(() => { const photo = categoryImage(category.slug, usedCategoryPhotos); return photo ? <img class="category-photo" src={photo.src} alt="" loading="lazy" width="160" height="160" /> : <b class="category-icon" aria-hidden="true">{icons[category.slug] ?? '🛍️'}</b>; })()}<strong>{labels[category.slug] ?? category.name}</strong><span>Browse finds →</span></a>)}</div></section>
</BaseLayout>
