---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { catalogCategories } from '../../lib/catalog';
import { searchCategorySlugs } from '../../lib/category-content';
const icons: Record<string, string> = { 't-shirts': '👕', dresses: '👗', jackets: '🧥', shoes: '👟', heels: '👠', 'trousers-pants': '👖', eyewear: '🕶️', perfume: '🧴', headwear: '🧢', 'underwear-swim': '🩱', electronics: '📱', 'scarves-ties': '🧣', 'jewelry-watches': '💍', 'socks-hosiery': '🧦' };
const labels: Record<string, string> = { shoes: 'Shoes', heels: 'High Heels', 'trousers-pants': 'Pants', eyewear: 'Sunglasses', headwear: 'Hats', 'underwear-swim': 'Underwear', 'scarves-ties': 'Scarves', 'jewelry-watches': 'Jewelry', 'socks-hosiery': 'Socks' };
const categories = searchCategorySlugs.map((slug) => catalogCategories.find((category) => category.slug === slug)).filter(Boolean);
---
<BaseLayout title="Oopbuy Spreadsheet Categories: Browse Focused Finds | OopbuyTop" description="Browse focused Oopbuy spreadsheet categories to compare product finds, available QC-photo context and current listing details.">
 <section class="hero compact"><p class="eyebrow">Catalog navigation</p><h1>Oopbuy Spreadsheet Categories</h1><p>Start with one product type to compare relevant finds, then verify the exact listing and option before acting. For the full research process, read the <a href="/oopbuy-spreadsheet/">Oopbuy spreadsheet guide</a>; for warehouse images, use the <a href="/guides/oopbuy-qc-photos/">QC photo guide</a>.</p></section>
 <section><div class="category-grid category-grid-fourteen">{categories.map((category) => category && <a class="category-card" href={`/category/${category.slug}/`}><b class="category-icon" aria-hidden="true">{icons[category.slug] ?? '🛍️'}</b><strong>{labels[category.slug] ?? category.name}</strong><span>Browse finds →</span></a>)}</div></section>
</BaseLayout>
