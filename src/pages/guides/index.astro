---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { guides } from '../../lib/guides';
const guideCards = [...Object.entries(guides).map(([slug, guide]) => ({ slug, title: guide.title, group: guide.group, description: guide.description })), {slug:'oopbuy-spreadsheet-categories', title:'Oopbuy spreadsheet categories', group:'Getting started', description:'Choose focused product categories instead of scrolling one long list.'}, {slug:'oopbuy-qc-photos', title:'Oopbuy QC photos', group:'QC & checks', description:'What QC images show and the details worth checking before shipment.'}, {slug:'oopbuy-shipping-guide', title:'Oopbuy shipping guide', group:'Shipping', description:'Plan a parcel carefully and verify the current option at checkout.'}];
---
<BaseLayout title="Oopbuy Spreadsheet Guides | OopbuyTop" description="Useful Oopbuy spreadsheet guides for browsing, checking listings and avoiding outdated links.">
 <section class="guides-hero"><p class="eyebrow">Research guides</p><h1>Oopbuy Spreadsheet Guides</h1><p>Practical reading for product discovery, QC checks and shipping decisions. Start with the step you are on.</p></section>
 <section class="guides-explainer"><div><p class="eyebrow">Use the guide like a map</p><h2>Research first. Decide with the live details.</h2></div><div><p>These guides are organized around the questions that happen before an order: how to narrow a category, compare a listing, review QC photos and plan a parcel. They do not process orders or replace the current information shown by an agent.</p><a class="text-link" href="/oopbuy-spreadsheet/">Read the complete spreadsheet workflow →</a></div></section>
 <section class="guides-hub">{['Getting started', 'QC & checks', 'Shipping'].map((group) => <div class="guide-group"><div class="guide-group-head"><p class="eyebrow">{group}</p><h2>{group === 'Getting started' ? 'Start with the basics' : group === 'QC & checks' ? 'Check before shipping' : 'Finish the workflow'}</h2></div><div class="guide-list">{guideCards.filter((guide) => guide.group === group).map((guide) => <a class="guide-card" href={`/guides/${guide.slug}/`}><span class="guide-card-number">0{guideCards.indexOf(guide) + 1}</span><h3>{guide.title}</h3><p>{guide.description}</p><b>Read guide →</b></a>)}</div></div>)}</section>
 <section class="guide-faq"><p class="eyebrow">Before you start</p><h2>Guide FAQ</h2><details><summary>Is this an official Oopbuy service?</summary><p>No. OopbuyTop is an independent research resource. Use official services for accounts, payment, orders and support.</p></details><details><summary>Can a spreadsheet confirm an item is available?</summary><p>No. It is a discovery tool. Confirm availability, options and price on the current live listing.</p></details><details><summary>Do QC photos guarantee product quality?</summary><p>No. They are a useful warehouse reference, not a guarantee. Compare them with the selected listing and decide before shipment.</p></details></section>
</BaseLayout>
