---
import type { Product } from '../lib/catalog';
import { displayPrice, maisonCategoryUrl } from '../lib/catalog';
const { product } = Astro.props as { product: Product };
const image = product.images?.[0];
---
<article class="product-card">
  {image && <img src={image} alt={product.title} loading="lazy" width="420" height="420" />}
  <div class="card-body"><p class="eyebrow">{product.brand || 'Curated find'} · {displayPrice(product)}</p><h3>{product.title}</h3><p>{product.qcPhotoCount ? `${product.qcPhotoCount} QC photos available` : 'Check listing details before ordering'}</p><a class="text-link" href={maisonCategoryUrl(product.category || '')} rel="sponsored">Browse current listings →</a></div>
</article>
