---
import type { Product } from '../lib/catalog';
import { displayPrice, maisonCategoryUrl } from '../lib/catalog';
const { product } = Astro.props as { product: Product };
const image = product.images?.[0];
---
<article class="product-card">
  <div class="product-media">
    {image && <img src={image} alt={product.title} loading="lazy" width="420" height="420" />}
    {product.qcPhotoCount ? <span class="qc-overlay">QC · {product.qcPhotoCount}</span> : <span class="qc-overlay qc-overlay-empty">No QC</span>}
  </div>
  <div class="card-body">
    <p class="eyebrow">{product.brand || 'Curated find'}</p>
    <h3>{product.title}</h3>
    <div class="product-meta"><span>{displayPrice(product)}</span><span class:list={['qc-badge', { 'has-qc': Boolean(product.qcPhotoCount) }]}>{product.qcPhotoCount ? `${product.qcPhotoCount} QC photos` : 'No QC photos'}</span></div>
    <a class="text-link" href={maisonCategoryUrl(product.category || '')} rel="sponsored">Browse listings →</a>
  </div>
</article>
